# Copy this file to .env.local and fill in the values.
# Without the Supabase values the site runs in "local mode" with sample pieces.

# Your site's address (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Resend: resend.com -> API keys. EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="ThinkInProducts <notes@yourdomain.com>"

# Resend webhook signing secret (Resend -> Webhooks). Used for open/click/bounce numbers.
RESEND_WEBHOOK_SECRET=

# MCP server for Claude. Pick a long random string, e.g. `openssl rand -hex 32`.
MCP_API_KEY=

# SEO
# The code Google Search Console gives you for the "HTML tag" method (just the content value).
GOOGLE_SITE_VERIFICATION=
# Fallback author name. Bylines and author pages use the Authors section of the admin.
NEXT_PUBLIC_AUTHOR_NAME="Madan"

# Admin login. Don't fill these in by hand: run `npm run admin:setup`, which asks for
# your email and a password, sets up two-factor codes and writes these to .env.local.
# For the live site, copy the same values into your host's environment variables.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# Signs admin sessions and form tokens. At least 32 random characters.
AUTH_SECRET=
# Sign out after this many minutes without activity (default 30), and after this many
# hours no matter what (default 12). Change ADMIN_SESSION_VERSION to sign out everywhere.
ADMIN_IDLE_MINUTES=30
ADMIN_MAX_HOURS=12
ADMIN_SESSION_VERSION=1

# Contact and "write for us" forms
# Optional: get an email when a new message or pitch arrives.
INBOX_NOTIFY_EMAIL=
# Optional extra bot check with Cloudflare Turnstile (free): dash.cloudflare.com -> Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
